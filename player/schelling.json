          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Soglia minima di vicini simili"
        }
      ],
      "valueExpression": "0.5"
    },
    {
      "id": 4,
      "name": "moversPerStep",
      "output": false,
      "global": false,
      "type": "parameter",
      "x": 1000,
      "y": 340,
      "width": 155,
      "height": 70,
      "fillColor": "#fff7d8",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Numero massimo di agenti mossi simultaneamente a ogni passo"
        }
      ],
      "valueExpression": "5"
    },
    {
      "id": 5,
      "name": "space",
      "output": true,
      "global": false,
      "type": "state",
      "x": 280,
      "y": 220,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Spazio: 0 = vuoto, 1 = tipo A, 2 = tipo B"
        }
      ],
      "stateTransition": "spaceNext",
      "initialState": "array(n,n, if(rand() < vacancy, 0, if(rand() < 0.5, 1, 2)))"
    },
    {
      "id": 6,
      "name": "occupiedN",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 280,
      "y": 420,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Numero di vicini occupati"
        }
      ],
      "input": false,
      "valueExpression": "array(size(space,0),size(space,1), count($value != 0, neighbors(space, $i0, $i1, true, true)))"
    },
    {
      "id": 7,
      "name": "sameN",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 360,
      "y": 320,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Numero di vicini dello stesso tipo"
        }
      ],
      "input": false,
      "valueExpression": "array(size(space,0),size(space,1), if(space[$i0,$i1] == 0, 0, count($value == space[$i0,$i1], neighbors(space, $i0, $i1, true, true))))"
    },
    {
      "id": 8,
      "name": "similarity",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 560,
      "y": 320,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Quota di vicini simili"
        }
      ],
      "input": false,
      "valueExpression": "array(size(space,0),size(space,1), if(space[$i0,$i1] == 0 or occupiedN[$i0,$i1] == 0, 1, sameN[$i0,$i1] / occupiedN[$i0,$i1]))"
    },
    {
      "id": 9,
      "name": "unhappyCoords",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 620,
      "y": 420,
      "width": 140,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Coordinate degli agenti insoddisfatti"
        }
      ],
      "input": false,
      "valueExpression": "filter(similarity[$value] < tau, coords(space), \"rows\")"
    },
    {
      "id": 10,
      "name": "emptyCoords",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 600,
      "y": 220,
      "width": 140,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Coordinate delle celle vuote"
        }
      ],
      "input": false,
      "valueExpression": "coords(space, 0)"
    },
    {
      "id": 11,
      "name": "moveCount",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 820,
      "y": 340,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Numero effettivo di movimenti nel passo"
        }
      ],
      "input": false,
      "valueExpression": "min(moversPerStep, size(unhappyCoords,0), size(emptyCoords,0))"
    },
    {
      "id": 12,
      "name": "moveFrom",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 880,
      "y": 140,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Coordinate delle partenze, estratte senza ripetizioni"
        }
      ],
      "input": false,
      "valueExpression": "if(moveCount == 0, [], shuffle(unhappyCoords)[range(moveCount), :])"
    },
    {
      "id": 13,
      "name": "moveTo",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 980,
      "y": 220,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Coordinate delle destinazioni, estratte senza ripetizioni"
        }
      ],
      "input": false,
      "valueExpression": "if(moveCount == 0, [], shuffle(emptyCoords)[range(moveCount), :])"
    },
    {
      "id": 14,
      "name": "moveValues",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 500,
      "y": 100,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Tipi degli agenti che si spostano"
        }
      ],
      "input": false,
      "valueExpression": "if(moveCount == 0, [], space[moveFrom])"
    },
    {
      "id": 15,
      "name": "movedIn",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 720,
      "y": 180,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Matrice sparsa dei tipi collocati nelle destinazioni"
        }
      ],
      "input": false,
      "valueExpression": "if(moveCount == 0, array(n,n,0), grid(col(moveTo,0), col(moveTo,1), [n,n], \"error\", moveValues))"
    },
    {
      "id": 16,
      "name": "movedOut",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 780,
      "y": 80,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Matrice sparsa delle celle lasciate libere"
        }
      ],
      "input": false,
      "valueExpression": "if(moveCount == 0, array(n,n,0), grid(col(moveFrom,0), col(moveFrom,1), [n,n]))"
    },
    {
      "id": 17,
      "name": "spaceNext",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 460,
      "y": 180,
      "width": 120,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Spazio dopo l'aggiornamento vettoriale simultaneo dei movimenti"
        }
      ],
      "input": false,
      "valueExpression": "if(movedIn != 0, movedIn, if(movedOut != 0, 0, space))"
    },
    {
      "id": 18,
      "name": "A",
      "output": true,
