  "nodes": [
    {
      "id": 1,
      "name": "coda",
      "output": true,
      "global": false,
      "type": "state",
      "x": 100,
      "y": 200,
      "width": 75,
      "height": 55,
      "fillColor": "#ffffff",
      "strokeColor": "#ffffff",
      "unit": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Numero di eventi in coda\n(implementazione come accumulatore)."
        }
      ],
      "stateTransition": "pos(this+evIn-(srv==kappa))",
      "initialState": "0"
    },
    {
      "id": 2,
      "name": "gen",
      "output": false,
      "global": false,
      "type": "state",
      "x": 100,
      "y": 80,
      "width": 75,
      "height": 65,
      "fillColor": "#ffffff",
      "strokeColor": "#ffffff",
      "unit": "",
      "properties": [
        {
          "key": "descrizione",
          "value": "Genera eventi booleani, secondo una distribuzione esponenziale negativa con parametro lambda (nota che il parametro va specificato come frequenza, dunque 1/lambda).\nLa variabile di stato opera come un countdown: ogni volta che il valore arriva a zero si genera un evento, e quindi si rende disponibile un nuovo evento rivalutando la distribuzione."
        },
        {
          "key": "note formula",
          "value": ""
        }
      ],
      "stateTransition": "if(this==0,round(exponential([1/lambda]),0),this-1)",
      "initialState": "round(exponential([1/lambda]),0)"
    },
    {
      "id": 3,
      "name": "kappa",
      "output": false,
      "global": false,
      "type": "parameter",
      "x": -20,
      "y": 320,
      "width": 75,
      "height": 45,
      "fillColor": "#ffff00",
      "strokeColor": "#ff0000",
      "unit": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Parametro del server: tempo (deterministico, in questo caso) necessario per gestire un singolo evento."
        }
      ],
      "valueExpression": "5"
    },
    {
      "id": 4,
      "name": "lambda",
      "output": false,
      "global": false,
      "type": "parameter",
      "x": -20,
      "y": 80,
      "width": 75,
      "height": 45,
      "fillColor": "#ffff00",
      "strokeColor": "#ff0000",
      "unit": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Parametro del generatore: periodo medio inter-generazione."
        }
      ],
      "valueExpression": "10"
    },
    {
      "id": 5,
      "name": "evOut",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 220,
      "y": 320,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "unit": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Evento in uscita\n(se il server era occupato e ora è libero)."
        }
      ],
      "input": false,
      "valueExpression": "srv==0&&srv_prec>0"
    },
    {
      "id": 6,
      "name": "occSrv",
      "output": false,
      "global": false,
      "type": "state",
      "x": 200,
      "y": 220,
      "width": 60,
      "height": 60,
      "fillColor": "",
      "strokeColor": "transparent",
      "unit": "",
      "properties": [
        {
          "key": "descrizione",
          "value": "Numero di periodi in cui il server è occupato."
        },
        {
          "key": "note formula",
          "value": ""
        }
      ],
      "stateTransition": "if(srv>0,this+1,this)",
      "initialState": "0"
    },
    {
      "id": 7,
      "name": "srv",
      "output": false,
      "global": false,
      "type": "state",
      "x": 100,
      "y": 320,
      "width": 75,
      "height": 65,
      "fillColor": "#ffffff",
      "strokeColor": "#ffffff",
      "unit": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Implementazione basata su questa logica: \n- se sei disponibile e c'è qualcuno in coda, diventa occupato; \n- altrimenti se sei impegnato e non avevi finito, continua; \n- altrimenti rimani disponibile. \nLa transizione di stato opera come un countdown: ogni volta che il valore arriva a zero il server diventa disponibile a gestire una nuova entità."
        }
      ],
      "stateTransition": "if(this==0&&coda>0,kappa,this>0,this-1,0)",
      "initialState": "0"
    },
    {
      "id": 8,
      "name": "srv_prec",
      "output": false,
      "global": false,
      "type": "state",
      "x": 100,
      "y": 420,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "transparent",
      "unit": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Ritardatore dello stato del server\n(per stabilire se il server ha completato la gestione di un'evento)."
        }
      ],
      "stateTransition": "srv",
      "initialState": "0"
    },
    {
      "id": 10,
      "name": "evIn",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 240,
      "y": 80,
      "width": 80,
      "height": 40,
      "fillColor": "",
      "strokeColor": "",
      "unit": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": ""
        }
      ],
      "input": false,
      "valueExpression": "gen==0"
    },
    {
      "id": 11,
      "name": "percOcc",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 300,
      "y": 220,
      "width": 80,
      "height": 60,
      "fillColor": "",
      "strokeColor": "",
      "unit": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Percentuale di occupazione di tempo del server\n(un possibile KPI del sistema)."
        }
      ],
      "input": false,
      "valueExpression": "100*occSrv/(time+1)"
    }
