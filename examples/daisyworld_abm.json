        },
        {
          "key": "descrizione",
          "value": "Indice spaziale toroidale della popolazione."
        }
      ],
      "input": false,
      "valueExpression": "agentSpace(daisies,1,2,0,[worldSize,worldSize],\"moore\",true)"
    },
