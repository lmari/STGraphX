        }
      ],
      "valueExpression": "0.72"
    },
    {
      "id": 6,
      "name": "daisies",
      "output": true,
      "global": false,
      "type": "state",
      "x": 310,
      "y": 255,
      "width": 145,
      "height": 74,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Popolazione dinamica: TYPE=-1 nera, TYPE=1 bianca; ogni passo rimuove individui e puo aggiungerne uno."
        }
      ],
      "stateTransition": "if(rand() < birthProbability, append(mapAgents([$value[0],$value[1],$value[2],$value[3],$value[4]+1], filterAgents($value[4] < maxAge and rand() > deathProbability, this)), [time+100000,randInt(0,worldSize-1),randInt(0,worldSize-1),if(rand()<0.5,-1,1),0]), mapAgents([$value[0],$value[1],$value[2],$value[3],$value[4]+1], filterAgents($value[4] < maxAge and rand() > deathProbability, this)))",
      "initialState": "agents([\"ID\",\"X\",\"Y\",\"TYPE\",\"AGE\"],array([initialDaisies,5],if($1==0,$0+1,if($1==1,randInt(0,worldSize-1),if($1==2,randInt(0,worldSize-1),if($1==3,if(rand()<0.5,-1,1),0))))))"
    },
