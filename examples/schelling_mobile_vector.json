      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Spazio: 0 = vuoto, 1 = tipo A, 2 = tipo B"
        }
      ],
      "stateTransition": "spaceNext",
      "initialState": "array(n,n, if(rand() < vacancy, 0, if(rand() < 0.5, 1, 2)))"
    },
    {
      "id": 6,
      "name": "occupiedN",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 660,
      "y": 100,
      "width": 170,
      "height": 76,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Numero di vicini occupati"
        }
      ],
      "valueExpression": "array(size(space,0),size(space,1), count($value != 0, neighbors(space, $i0, $i1, true, true)))",
      "input": false
    },
    {
      "id": 7,
      "name": "sameN",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 660,
      "y": 205,
      "width": 170,
      "height": 76,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Numero di vicini dello stesso tipo"
        }
      ],
      "valueExpression": "array(size(space,0),size(space,1), if(space[$i0,$i1] == 0, 0, count($value == space[$i0,$i1], neighbors(space, $i0, $i1, true, true))))",
      "input": false
    },
    {
      "id": 8,
      "name": "similarity",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 660,
      "y": 310,
      "width": 170,
      "height": 76,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Quota di vicini simili"
        }
      ],
      "valueExpression": "array(size(space,0),size(space,1), if(space[$i0,$i1] == 0 or occupiedN[$i0,$i1] == 0, 1, sameN[$i0,$i1] / occupiedN[$i0,$i1]))",
      "input": false
    },
    {
      "id": 9,
      "name": "unhappyCoords",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 950,
      "y": 110,
      "width": 190,
      "height": 86,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Coordinate degli agenti insoddisfatti"
        }
      ],
      "valueExpression": "filter(similarity[$value] < tau, coords(space), \"rows\")",
      "input": false
    },
    {
      "id": 10,
      "name": "emptyCoords",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 950,
      "y": 220,
      "width": 170,
      "height": 86,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Coordinate delle celle vuote"
        }
      ],
      "valueExpression": "coords(space, 0)",
      "input": false
    },
    {
      "id": 11,
      "name": "moveCount",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 950,
      "y": 340,
      "width": 175,
      "height": 76,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Numero effettivo di movimenti nel passo"
        }
      ],
      "valueExpression": "min(moversPerStep, size(unhappyCoords,0), size(emptyCoords,0))",
      "input": false
    },
    {
      "id": 12,
      "name": "moveFrom",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 1230,
      "y": 120,
      "width": 190,
      "height": 86,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Coordinate delle partenze, estratte senza ripetizioni"
        }
      ],
      "valueExpression": "shuffle(unhappyCoords)[range(moveCount)]",
      "input": false
    },
    {
      "id": 13,
      "name": "moveTo",
      "output": false,
