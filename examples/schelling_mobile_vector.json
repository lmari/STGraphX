          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Tipi degli agenti che si spostano"
        }
      ],
      "valueExpression": "space[moveFrom]",
      "input": false
    },
    {
      "id": 15,
      "name": "movedIn",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 1490,
      "y": 160,
      "width": 190,
      "height": 86,
      "fillColor": "",
      "strokeColor": "",
      "properties": [
        {
