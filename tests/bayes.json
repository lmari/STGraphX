  "nodes": [
    {
      "id": 1,
      "name": "data",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 110,
      "y": 190,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Simulate a Gaussian observation."
        }
      ],
      "input": false,
      "valueExpression": "gaussian([par1,par2])"
    },
    {
      "id": 2,
      "name": "hyp1",
      "output": true,
      "global": false,
      "type": "parameter",
      "x": 200,
      "y": 0,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Categories for hypothesis testing on expected value."
        }
      ],
      "valueExpression": "range(-2.5, 2.5, 0.05)"
    },
    {
      "id": 3,
      "name": "hyp2",
      "output": true,
      "global": false,
      "type": "parameter",
      "x": 140,
      "y": 40,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Categories for hypothesis testing on standard deviation."
        }
      ],
      "valueExpression": "range(0.1, 3, 0.05)"
    },
    {
      "id": 4,
      "name": "likelihood",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 220,
      "y": 150,
      "width": 75,
      "height": 45,
      "fillColor": "#00ffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": "array(size(hyp1),size(hyp2),\n  (1/hyp2[$1])*exp(-(hyp1[$0]-data)^2/(2*hyp2[$1]^2))\n)"
        },
        {
          "key": "descrizione",
          "value": "Likelihood, i.e., probability of the data given the (different) hypotheses."
        }
      ],
      "input": false,
      "valueExpression": "array(size(hyp1),size(hyp2),\n  (1/hyp2[$1])*exp(-(hyp1[$0]-data)^2/(2*hyp2[$1]^2))\n)"
    },
    {
      "id": 5,
      "name": "marg2",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 460,
      "y": 180,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Estimated distribution on standard deviation, obtained by marginalization of the posterior."
        }
      ],
      "input": false,
      "valueExpression": "reduce(+, prob, 0, 0)"
    },
    {
      "id": 6,
      "name": "marg1",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 460,
      "y": 120,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Estimated distribution on expected value, obtained by marginalization of the posterior."
        }
      ],
      "input": false,
      "valueExpression": "reduce(+, prob, 1, 0)"
    },
    {
      "id": 7,
      "name": "par1",
      "output": false,
      "global": false,
      "type": "parameter",
      "x": 0,
      "y": 180,
      "width": 75,
      "height": 45,
      "fillColor": "#ff0000",
      "strokeColor": "#f5f5f5",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "The first parameter -- expected value -- to be estimated\n(i.e., supposed to be unknown)."
        }
      ],
      "valueExpression": "-0.5"
    },
    {
      "id": 8,
      "name": "par2",
      "output": false,
      "global": false,
      "type": "parameter",
      "x": 0,
      "y": 240,
      "width": 75,
      "height": 45,
      "fillColor": "#ff0000",
      "strokeColor": "#f5f5f5",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "The second parameter -- standard deviation -- to be estimated\n(i.e., supposed to be unknown)."
        }
      ],
      "valueExpression": "1.0"
    },
    {
      "id": 9,
      "name": "prior",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 260,
      "y": 100,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Prior probability distribution, assumed uniform for maximum entropy."
        }
      ],
      "input": false,
      "valueExpression": "array(size(hyp1),size(hyp2),1/(size(hyp1)*size(hyp2)))"
    },
    {
      "id": 10,
      "name": "prob",
      "output": true,
      "global": false,
      "type": "state",
      "x": 340,
      "y": 150,
      "width": 75,
      "height": 45,
      "fillColor": "#00ffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": "Dynamically / sequentially modified posterior distribution.\nFrom a prior distribution, it is adapted to new data by means of likelihood."
        }
      ],
      "stateTransition": "(this*likelihood)/(reduce(+, reduce(+, (this*likelihood), 0), 0))",
      "initialState": "prior"
    },
    {
      "id": 23,
      "name": "est1",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 580,
      "y": 120,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": ""
        }
      ],
      "input": false,
      "valueExpression": "hyp1[argmax(marg1)]"
    },
    {
      "id": 24,
      "name": "est2",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 580,
      "y": 180,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "note formula",
          "value": ""
        },
        {
          "key": "descrizione",
          "value": ""
        }
      ],
      "input": false,
      "valueExpression": "hyp2[argmax(marg2)]"
    }
  ],
