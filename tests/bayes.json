  "nodes": [
    {
      "id": 1,
      "name": "data",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 110,
      "y": 150,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "description",
          "value": "Simulate a Gaussian observation."
        }
      ],
      "valueExpression": "gaussian([par1,par2])",
      "input": false
    },
    {
      "id": 2,
      "name": "hyp1",
      "output": true,
      "global": false,
      "type": "parameter",
      "x": 150,
      "y": 100,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "description",
          "value": "Categories for hypothesis testing on expected value."
        }
      ],
      "valueExpression": "[-2.0:0.1:2.0]"
    },
    {
      "id": 3,
      "name": "hyp2",
      "output": true,
      "global": false,
      "type": "parameter",
      "x": 190,
      "y": 60,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "description",
          "value": "Categories for hypothesis testing on standard deviation."
        }
      ],
      "valueExpression": "[0.1:0.1:3.0]"
    },
    {
      "id": 4,
      "name": "likelihood",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 220,
      "y": 150,
      "width": 75,
      "height": 45,
      "fillColor": "#00ffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "description",
          "value": "Likelihood, i.e., probability of the data given the (different) hypotheses."
        }
      ],
      "valueExpression": "array([@hyp1,@hyp2],(1/hyp2[$i1])*exp(-(hyp1[$i0]-data)^2/(2*hyp2[$i1]^2)))",
      "input": false
    },
    {
      "id": 5,
      "name": "marg1",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 430,
      "y": 120,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "description",
          "value": "Estimated distribution on standard deviation, obtained by marginalization of the posterior."
        }
      ],
      "valueExpression": "reduce(+, prob, 0)",
      "input": false
    },
    {
      "id": 6,
      "name": "marg2",
      "output": true,
      "global": false,
      "type": "algebraic",
      "x": 430,
      "y": 180,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "description",
          "value": "Estimated distribution on expected value, obtained by marginalization of the posterior."
        }
      ],
      "valueExpression": "reduce(+, [0], 0)prob",
      "input": false
    },
    {
      "id": 7,
      "name": "par1",
      "output": false,
      "global": false,
      "type": "parameter",
      "x": 10,
      "y": 130,
      "width": 75,
      "height": 45,
      "fillColor": "#ff0000",
      "strokeColor": "#f5f5f5",
      "properties": [
        {
          "key": "description",
          "value": "The first parameter -- expected value -- to be estimated\n(i.e., supposed to be unknown)."
        }
      ],
      "valueExpression": "-0.5"
    },
    {
      "id": 8,
      "name": "par2",
      "output": false,
      "global": false,
      "type": "parameter",
      "x": 10,
      "y": 180,
      "width": 75,
      "height": 45,
      "fillColor": "#ff0000",
      "strokeColor": "#f5f5f5",
      "properties": [
        {
          "key": "description",
          "value": "The second parameter -- standard deviation -- to be estimated\n(i.e., supposed to be unknown)."
        }
      ],
      "valueExpression": "0.5"
    },
    {
      "id": 9,
      "name": "prior",
      "output": false,
      "global": false,
      "type": "algebraic",
      "x": 270,
      "y": 100,
      "width": 75,
      "height": 45,
      "fillColor": "#ffffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "description",
          "value": "Prior probability distribution, assumed uniform for maximum entropy."
        }
      ],
      "valueExpression": "array([@hyp1,@hyp2],1/(@hyp1*@hyp2))",
      "input": false
    },
    {
      "id": 10,
      "name": "prob",
      "output": true,
      "global": false,
      "type": "state",
      "x": 340,
      "y": 150,
      "width": 75,
      "height": 45,
      "fillColor": "#00ffff",
      "strokeColor": "#000000",
      "properties": [
        {
          "key": "description",
          "value": "Dynamically / sequentially modified posterior distribution.\nFrom a prior distribution, it is adapted to new data by means of likelihood."
        }
      ],
      "initialState": "prior",
      "stateTransition": "(this*likelihood)/(reduce(+, reduce(+, (this*likelihood), 0), 0))"
    }
  ],
